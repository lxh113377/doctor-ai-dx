# 复制为 .env 后填写。MVP 无 key 时自动降级为内置演示数据（mock 回退）。
# LLM 服务商（默认 DeepSeek，OpenAI 兼容；LLM_PROVIDER 可选 openai_compatible，换供应商注册新 Provider 后配置）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_PROVIDER=openai_compatible

# 服务
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 管理后台令牌（/api/admin/*）。留空＝后台一律 503 拒绝，绝不因为「没配」就放行。
# 部署到 Cloudflare Pages 时走 `wrangler pages secret put ADMIN_TOKEN`，不要写进 wrangler.toml 的 [vars]。
ADMIN_TOKEN=

# 构建期工具（不参与线上运行时：`scripts/build_semantic_neighbors.py` 用本地 BGE 权重蒸馏语义邻接表）
# 留空＝用默认缓存位置；线上零模型零网络，语义档为 opt-in（默认档 bm25）
BGE_ENGINE_DIR=