# 覆盖率配置（对标 phlox 的 .coveragerc 形态；工具 = coverage.py 7.16.0，无外部件）
[run]
source = app
# 第十四轮起计入分支弧（此前只算语句覆盖）：语句 100% 也可能 if 的另一侧从未走过，
# 而本仓红线（红旗/引用白名单/终审文案）恰恰多数藏在分支里。开启后实测总量 89%（口径变更已同步地板）。
branch = True
omit =
    */tests/*
    */__pycache__/*
    .venv/*
    venv/*

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
    if TYPE_CHECKING:
    del 
