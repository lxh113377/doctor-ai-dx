# ============================================================
# agent-service（面3 · Agent SDK 表达层）环境变量样例
# 由 init-cbc-sdk-web 模板复制而来；模板本身不带此文件，此处补齐并加本项目专有项。
# 用法：cp .env.example .env 后填值。.env 已被 .gitignore 排除，禁止提交真实值。
# ============================================================

# ---- 面2（权威判定面，Cloudflare Pages Functions）----
# 权威判定永远在面2：意图识别 / 红旗闸门 / 弃权 / 转人工 全部在那边完成。
# 本地跑 wrangler pages dev 时用 http://127.0.0.1:8788；线上用已部署的 Pages 地址。
MED_CHAT_API_BASE=https://doctor-ai-dx.pages.dev
# 面2 单次请求超时（毫秒）。面2 不可达时本服务返回 502，不用本地假数据冒充判定结果。
MED_CHAT_TIMEOUT_MS=20000

# ---- Agent SDK（表达层）----
# 装了不等于能用：SDK 是通过子进程调 CodeBuddy CLI 的，所以还得有 CLI 且已认证。
# 装 CLI：npm install -g @tencent-ai/codebuddy-code
# 认证二选一：① 设 CODEBUDDY_API_KEY  ② 首次运行 `codebuddy` 走浏览器认证
CODEBUDDY_API_KEY=
# 可选：显式指定 CLI 路径（探测已验证可执行时用它，避免子进程 PATH 差异）
CODEBUDDY_CODE_PATH=
# 设 0 可强制关闭 Agent 编排，全部对话走确定性话术链路（CI 与离线复算用）
AGENT_SDK_ENABLED=1
# 表达层单次硬超时（毫秒），与既有面 SLOW_MS=8000 同族口径
AGENT_TIMEOUT_MS=8000

# ---- 服务本身 ----
PORT=3000