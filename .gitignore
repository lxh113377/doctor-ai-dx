# 依赖与构建产物
node_modules/
dist/
*.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# wrangler 本地状态
.wrangler/
.dev.vars.*

# 环境与密钥（禁止入库）
.env
.env.*
.dev.vars
!.env.example

# 备份/回收
backup/
_bak/
*.bak

# 系统
.DS_Store
Thumbs.db

# 覆盖率产物（c8 / coverage.py，本地与 CI 生成，禁入库）
coverage/
.c8-tmp/
.coverage
*.cover
htmlcov/
.coverage.json
coverage-py.json
.mypy_cache/

# SBOM 为发布期产物（scripts/sbom_guard.mjs 校验、release.yml 作为 Release 资产上传），不入库防陈旧副本
frontend/report.cdx.json
docs/sbom/

# Playwright 运行期产物（e2e 作业本地/CI 生成，禁入库）
test-results/
playwright-report/
blob-report/

# 线上评测原始报告（每次跑都变；入库即造第二真值，见 scripts/perf_gate.mjs 的 UNKNOWN 口径）
.eval/

# ci_watch 的观察输出是临时产物（本轮实测把 _ci.log 误提交进 tag 树，故显式排除）
_ci.log
