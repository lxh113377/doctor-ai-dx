      "vitals": [{ "key": "RR", "value": "24" }, { "key": "BP", "value": "90/60" }],
      "text": "发热三天，高热寒战，意识模糊，血压测不到边缘",
      "expect_flags": [{ "name": "qSOFA评分 3/3", "severity": "高" }],
      "expect_missing": { "qsofa": [], "shock_index": ["si", "si"] }
    },
    {
      "id": "qsofa_partial_no_trigger",
      "vitals": [{ "key": "RR", "value": "24" }],
      "text": "咳嗽三天，白黏痰",
      "expect_flags": [],
      "expect_missing": { "qsofa": ["sbp"], "shock_index": ["si", "si"] }
    },
    {
      "id": "shock_index_high",
      "vitals": [{ "key": "HR", "value": "130" }, { "key": "BP", "value": "100/60" }],
      "text": "外伤后口渴、面色苍白",
      "expect_flags": [{ "name": "休克指数 SI评分 2/2", "severity": "高" }],
      "expect_missing": { "qsofa": ["rr"], "shock_index": [] }
    },
    {
      "id": "shock_index_mid",
      "vitals": [{ "key": "HR", "value": "95" }, { "key": "BP", "value": "100/60" }],
