{
  "name": "doctor-ai-dx-frontend",
  "private": true,
  "version": "1.22.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:js": "eslint . --max-warnings=0",
    "lint:py": "cd .. && ruff check backend/app backend/tests scripts",
    "lint": "npm run lint:js && npm run lint:py",
    "test:e2e": "playwright test",
    "typecheck": "cd .. && python scripts/type_gate.py",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm@6.0.1 --sv 1.5 --mc-type application -o ../docs/sbom/frontend.cdx.json",
    "sbom:check": "node tests/sbom_guard.mjs --sbom docs/sbom/frontend.cdx.json --manifest npm",
    "test:smoke": "node tests/engine_smoke.mjs",
    "test:engine": "node tests/engine_eval.mjs",
    "test:accuracy": "node tests/accuracy_guard.mjs",
    "test:retrieval": "node tests/retrieval_eval.mjs",
    "test:contract": "node tests/contract_parity.mjs",
    "test:fhir": "node tests/fhir_guard.mjs",
    "test:kb": "node tests/kb_guard.mjs",
    "test:route": "node tests/route_guard.mjs",
    "test:api": "node tests/api_contract_guard.mjs",
    "test:error-parity": "node tests/error_parity_guard.mjs",
    "test:bundle": "node tests/bundle_size_guard.mjs",
    "test": "npm run test:smoke && npm run test:engine && npm run test:accuracy && npm run test:retrieval && npm run test:retrieval-parity && npm run test:semantic && npm run test:live && npm run test:contract && npm run test:fhir && npm run test:kb && npm run test:route && npm run test:privacy && npm run test:env && npm run test:limits && npm run test:docs && npm run test:api && npm run test:error-parity && npm run test:components && npm run test:version",
    "test:retrieval-parity": "node tests/retriever_parity.mjs",
    "test:components": "vitest run",
    "test:version": "node tests/version_guard.mjs",
    "gen:openapi": "python ../scripts/gen_openapi.py",
    "test:links": "node tests/link_health.mjs",
    "test:semantic": "node tests/semantic_guard.mjs",
    "test:live": "node tests/live_path_guard.mjs",
    "test:env": "node tests/env_guard.mjs",
    "lock": "cd .. && python scripts/lock_guard.py",
    "deps:check": "cd .. && python scripts/dep_completeness.py",
    "deps:triage": "cd .. && python scripts/dep_triage.py",
    "smoke:live": "cd .. && python scripts/live_smoke.py",
    "smoke:selftest": "cd .. && python scripts/live_smoke.py --selftest",
    "deps:triage:selftest": "cd .. && python scripts/dep_triage.py --selftest",
    "actions": "cd .. && python scripts/action_pin.py --verify --offline",
    "actions:selftest": "cd .. && python scripts/action_pin.py --selftest",
    "coverage:js": "c8 npm test && node tests/coverage_floor_guard.mjs",
    "coverage:py": "cd ../backend && rm -f .coverage && python selftest.py --coverage && python ../scripts/coverage_gate.py",
    "test:privacy": "node tests/privacy_guard.mjs",
    "test:limits": "node tests/limits_guard.mjs",
    "test:docs": "node tests/docs_link_guard.mjs",
    "test:backend": "cd ../backend && python selftest.py",
    "test:suite": "cd .. && python scripts/suite_guard.py",
    "kb:export": "node ../scripts/export_kb.mjs",
    "eval:live": "node ../scripts/live_eval.mjs",
    "perf:gate": "node ../scripts/perf_gate.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "c8": "^12.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.1"
  }
}
