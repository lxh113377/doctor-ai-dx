{
  "name": "doctor-ai-dx-frontend",
  "private": true,
  "version": "1.16.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:js": "eslint . --max-warnings=0",
    "lint:py": "cd .. && ruff check backend/app backend/tests scripts",
    "lint": "npm run lint:js && npm run lint:py",
    "test:e2e": "playwright test",
    "typecheck": "cd .. && python scripts/type_gate.py",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm@6.0.1 --sv 1.5 --mc-type application -o ../docs/sbom/frontend.cdx.json",
    "sbom:check": "node tests/sbom_guard.mjs --sbom docs/sbom/frontend.cdx.json --manifest npm",
    "test:smoke": "node tests/engine_smoke.mjs",
    "test:engine": "node tests/engine_eval.mjs",
    "test:retrieval": "node tests/retrieval_eval.mjs",
    "test:contract": "node tests/contract_parity.mjs",
    "test:fhir": "node tests/fhir_guard.mjs",
    "test:kb": "node tests/kb_guard.mjs",
    "test:route": "node tests/route_guard.mjs",
    "test:api": "node tests/api_contract_guard.mjs",
    "test:bundle": "node tests/bundle_size_guard.mjs",
    "test": "npm run test:smoke && npm run test:engine && npm run test:retrieval && npm run test:retrieval-parity && npm run test:semantic && npm run test:live && npm run test:contract && npm run test:fhir && npm run test:kb && npm run test:route && npm run test:privacy && npm run test:env && npm run test:api && npm run test:components && npm run test:version",
    "test:retrieval-parity": "node tests/retriever_parity.mjs",
    "test:components": "vitest run",
    "test:version": "node tests/version_guard.mjs",
    "gen:openapi": "python ../scripts/gen_openapi.py",
    "test:links": "node tests/link_health.mjs",
    "test:semantic": "node tests/semantic_guard.mjs",
    "test:live": "node tests/live_path_guard.mjs",
    "test:env": "node tests/env_guard.mjs",
    "lock": "cd .. && python scripts/lock_guard.py",
    "coverage:js": "c8 npm test && node tests/coverage_floor_guard.mjs",
    "coverage:py": "cd ../backend && rm -f .coverage && python -m coverage run --append --source=app tests/smoke_engine.py && python -m coverage run --append --source=app tests/test_api_observe.py && python -m coverage run --append --source=app tests/test_fhir.py && python -m coverage run --append --source=app tests/test_live_path.py && python -m coverage run --append --source=app tests/test_retriever_channels.py && python ../scripts/coverage_gate.py",
    "test:privacy": "node tests/privacy_guard.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.5.0",
    "c8": "^12.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "vite": "^6.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.1"
  }
}
